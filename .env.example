# ---------------------------------------------------------------------------
# Cinagi WhatsApp Platform - environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000

# Encryption key for per-workspace WhatsApp credentials stored in the database.
# Generate with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If left blank a key is derived from DJANGO_SECRET_KEY (fine for dev, not prod).
FIELD_ENCRYPTION_KEY=

# Database -------------------------------------------------------------------
# DB_ENGINE=sqlite gives a zero-setup local database (used by the test suite).
# DB_HOST:  postgres              when the app runs in Docker with the compose database
#           localhost             when you run manage.py on your own machine
#           host.docker.internal  when the app runs in Docker but the database is on your machine
DB_ENGINE=postgres
DB_NAME=cinagi_wa
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis ----------------------------------------------------------------------
# USE_REDIS=False runs everything on Postgres alone: background jobs execute
# inline, the live inbox uses an in-process channel layer, the cache is local
# memory. Good enough for one developer; switch it on for staging and production,
# where several processes have to share state.
USE_REDIS=False

# DB 0 = celery broker, 1 = results, 2 = channel layer (websockets), 3 = cache
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNELS_REDIS_URL=redis://redis:6379/2
CACHE_REDIS_URL=redis://redis:6379/3

# Outbound safety rail -------------------------------------------------------
# suppress  = nothing leaves the building (default for development)
# allowlist = only numbers in OUTBOUND_ALLOWLIST receive messages (staging)
# live      = real customers receive messages (production only)
OUTBOUND_COMMS_MODE=suppress
OUTBOUND_ALLOWLIST=

# WhatsApp -------------------------------------------------------------------
# Per-workspace credentials (phone number id, token, app secret) are stored in
# the database and entered through the Connect a number wizard - NOT here.
WHATSAPP_GRAPH_VERSION=v21.0

# Only needed to submit the template pack from the command line
# (python manage.py submit_templates). Day to day, credentials live per
# workspace in the database instead.
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI (phase 6, not used yet) -------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
